# Standalone catalyst-books image (gaka-zp2s P4) — the books domain running in
# ISOLATION, built from the SAME monorepo as boomtime but importing none of the
# code domain (proven: `go list -deps ./cmd/catalyst-books` pulls in 0
# internal/boomtime packages). Serves the books HTTP surface AND the books-only
# SPA (same boomtime shell/theme, ONLY the books domain surfaced — see
# web/src/books-main.tsx + `yarn build:books`).
#
#   docker build -f Dockerfile.catalyst-books -t catalyst-books .
#
# ── Stage 1: build the books-only SPA ────────────────────────────────────────
# Mirrors the host Dockerfile's web stage but runs `yarn build:books` → the
# tree-shaken, boomtime-free bundle in web/dist-books.
FROM node:22-alpine AS web
WORKDIR /web
COPY web/package.json web/yarn.lock ./
# --ignore-engines: a transitive dep declares node>=24 but nothing here needs
# node 24 semantics (see the host Dockerfile for the full rationale).
RUN yarn install --frozen-lockfile --ignore-engines
COPY web/ ./
# The "@widget-specs" alias resolves to ../internal/boomtime/widget/specs.json;
# this stage only copies web/, and the books build's tsc pass type-checks every
# src file (even the tree-shaken ones), so provide the single source at the
# aliased path — no duplicate, still one source of truth.
COPY internal/boomtime/widget/specs.json /internal/boomtime/widget/specs.json
# gaka-zp2s / gaka-abg0 Step B: the books domain FE is PHYSICALLY colocated with
# THIS Go package under internal/books/web/src (outside /web), reached via the
# `@books/*` alias and scanned for Tailwind via an @source in web/src/index.css.
# The standalone books entry (index.books.html → books-main.tsx) composes it, so
# bring the source in at the aliased path (no duplicate — same tree the host
# build reads). tsc resolves bare deps by walking up from each file, so also
# link the colocated root's node_modules at /web/node_modules.
COPY internal/books/web/src /internal/books/web/src
RUN ln -s /web/node_modules /internal/books/web/node_modules
RUN yarn build:books

# ── Stage 2: build the Go binary with the books SPA embedded ─────────────────
FROM golang:1.25-alpine AS server
ARG VERSION=dev
RUN apk add --no-cache git
WORKDIR /src
COPY go.mod go.sum* ./
RUN go mod download
# .dockerignore guards secrets/junk out of the builder layers.
COPY . .
# Embed the books-only SPA (internal/books/web embeds internal/books/web/dist).
COPY --from=web /web/dist-books ./internal/books/web/dist
RUN CGO_ENABLED=0 GOOS=linux go build \
    -ldflags "-s -w" \
    -o /out/catalyst-books ./cmd/catalyst-books

# ── Stage 2: minimal runtime ─────────────────────────────────────────────────
FROM alpine:3.20
ARG VERSION=dev
LABEL org.opencontainers.image.title="catalyst-books" \
      org.opencontainers.image.description="Standalone catalyst-books server — Amazon (Kindle/Audible) + Hardcover reading domain, extracted from boomtime." \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.source="https://github.com/TheBranchDriftCatalyst/boomtime" \
      org.opencontainers.image.licenses="Unlicense"
RUN apk add --no-cache ca-certificates tzdata && adduser -D -u 10001 books
COPY --from=server /out/catalyst-books /usr/local/bin/catalyst-books
USER books
# Books is the whole app here; the entrypoint also forces the gate on internally.
ENV BOOM_PORT=8080 BOOM_FEATURE_BOOKS=true
EXPOSE 8080
# The standalone entrypoint runs migrations then serves (no subcommands).
ENTRYPOINT ["catalyst-books"]

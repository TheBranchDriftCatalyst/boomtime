{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    // Part B Stage 2: src/features/widgets/specs.ts imports the shared
    // internal/widget/specs.json (via the "@widget-specs" path below) as a
    // typed value import.
    "resolveJsonModule": true,

    "types": ["vitest/globals", "@testing-library/jest-dom"],

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,

    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      // gaka-zp2s / gaka-abg0 Step B: books FE colocated with its Go package
      // under internal/books/web/src (mirrors the Vite `@books` alias).
      "@books/*": ["../internal/books/web/src/*"],
      // gaka-zp2s / gaka-abg0 Step B Phase 2: boomtime (code) domain FE
      // colocated with its Go package under internal/boomtime/web/src
      // (mirrors the Vite `@boomtime` alias).
      "@boomtime/*": ["../internal/boomtime/web/src/*"],
      "@widget-specs": ["../internal/boomtime/widget/specs.json"]
    }
  },
  "include": ["src", "../internal/books/web/src", "../internal/boomtime/web/src"]
}

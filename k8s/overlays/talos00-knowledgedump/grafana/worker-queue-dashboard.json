  "description": "Worker-topology decoupling (gaka-8bz follow-up): RabbitMQ queue depth/consumers/throughput for boomtime.image-jobs, plus the boomtime-worker Deployment's replica count (the visible effect of the KEDA queue-length ScaledObject). No app-level metrics yet — boomtime doesn't expose /metrics — so this is broker + scaling visibility only; see the boomtime Admin tab (Settings -> Admin -> label images) for per-job state.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["app-ops", "boomtime", "rabbitmq", "keda"],
  "templating": { "list": [] },
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "boomtime — Image-Job Worker Queue",
  "uid": "boomtime-worker-queue",
  "version": 1,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "title": "Broker — boomtime.image-jobs",
      "type": "row"
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Queue depth (ready)",
      "description": "Messages published but not yet picked up by a consumer. Sustained >0 with 0 consumers means the worker is scaled to zero (KEDA cold start) or down.",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "targets": [
        {
          "expr": "sum(rabbitmq_queue_messages_ready{namespace=\"boomtime\", queue=\"boomtime.image-jobs\"})",
          "legendFormat": "ready"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": 0, "color": "green" },
              { "value": 5, "color": "yellow" },
              { "value": 20, "color": "red" }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Consumers",
      "description": "AMQP consumers currently subscribed — should track the worker replica count 1:1 (concurrency=1 per consumer prefetch-qos slot per worker pod, see BOOM_LABEL_IMAGE_CONCURRENCY).",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "targets": [
        {
          "expr": "sum(rabbitmq_queue_consumers{namespace=\"boomtime\", queue=\"boomtime.image-jobs\"})",
          "legendFormat": "consumers"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } },
      "options": {
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "boomtime-worker replicas",
      "description": "Current replica count of the Deployment KEDA scales (min 0 / max 4, see keda-scaledobject.yaml).",
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "targets": [
        {
          "expr": "sum(kube_deployment_status_replicas{namespace=\"boomtime\", deployment=\"boomtime-worker\"})",
          "legendFormat": "replicas"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } },
      "options": {
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value"
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Unacked (in-flight)",
      "description": "Delivered to a worker but not yet ack'd — a job actively regenerating (or stuck mid-crash awaiting redelivery).",
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "targets": [
        {
          "expr": "sum(rabbitmq_queue_messages_unacked{namespace=\"boomtime\", queue=\"boomtime.image-jobs\"})",
          "legendFormat": "unacked"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } },
      "options": {
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value"
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Queue depth over time",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 7 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "targets": [
        {
          "expr": "sum(rabbitmq_queue_messages_ready{namespace=\"boomtime\", queue=\"boomtime.image-jobs\"})",
          "legendFormat": "ready"
        },
        {
          "expr": "sum(rabbitmq_queue_messages_unacked{namespace=\"boomtime\", queue=\"boomtime.image-jobs\"})",
          "legendFormat": "unacked"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "boomtime-worker replicas (KEDA scaling activity)",
      "description": "The observable effect of the ScaledObject reacting to queue depth — should rise shortly after a burst of enqueues and fall back to 0 after the cooldownPeriod (120s) once the queue drains.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 7 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "targets": [
        {
          "expr": "sum(kube_deployment_status_replicas{namespace=\"boomtime\", deployment=\"boomtime-worker\"})",
          "legendFormat": "current"
        },
        {
          "expr": "sum(kube_deployment_spec_replicas{namespace=\"boomtime\", deployment=\"boomtime-worker\"})",
          "legendFormat": "desired"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Publish / deliver rate",
      "description": "Enqueue rate (server publishes) vs. delivery rate (worker consumes). A widening gap between the two means the queue is growing faster than the worker(s) can drain it.",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 15 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "targets": [
        {
          "expr": "sum(rate(rabbitmq_queue_messages_published_total{namespace=\"boomtime\", queue=\"boomtime.image-jobs\"}[5m]))",
          "legendFormat": "published/s"
        },
        {
          "expr": "sum(rate(rabbitmq_queue_messages_delivered_total{namespace=\"boomtime\", queue=\"boomtime.image-jobs\"}[5m]))",
          "legendFormat": "delivered/s"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" } }
    }
  ]
}

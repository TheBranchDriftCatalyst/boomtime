      "type": "logs",
      "title": "Whispersync advances (book · location · Δloc · interval)",
      "datasource": {
        "type": "loki",
        "uid": "loki-v2"
      },
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 31
      },
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki-v2"
          },
          "expr": "{namespace=\"boomtime\"} |~ `reading monitor: advance` | json | source =~ `$source` | line_format \"{{.source}}  {{.owner}}  {{.book}}  loc={{.location}}  Δloc={{.dloc}}  interval={{.interval_s}}s  ({{.creation_time}})  asin={{.asin}}\""
        }
      ],
      "description": "Every observed whispersync advance, newest first, one line per ping: source / owner / book / furthest location / Δlocation / interval since the previous advance / Amazon creationTime / ASIN. This raw stream is what the percentile and histogram panels above are computed from — expand a line for the full structured payload."
    }
  ]

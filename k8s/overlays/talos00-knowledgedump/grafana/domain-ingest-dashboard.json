{
  "uid": "boomtime-domain-ingest",
  "title": "boomtime \u2014 Domain Ingest",
  "description": "DOMAIN-perspective view of data flowing INTO and OUT OF boomtime: catalyst-waka coding heartbeats and catalyst-health workout/HealthKit samples arriving, whether they were accepted, what they cost to swallow, and which domain endpoints are being read back. SOURCES: entirely boomtime's structured JSON slog http-request records in Loki (namespace=boomtime) \u2014 the app exposes no Prometheus metrics. KNOWN GAP: these are REQUEST counts. A bulk POST carries an arbitrary number of heartbeats and boomtime logs no per-request count, so volume here is proportional to, but not equal to, heartbeats stored. Project and language attribution is not observable at all.",
  "tags": [
    "boomtime",
    "apps",
    "domain",
    "ingest",
    "waka"
  ],
  "schemaVersion": 39,
  "version": 1,
  "id": null,
  "editable": true,
  "graphTooltip": 1,
  "liveNow": false,
  "preload": false,
  "fiscalYearStartMonth": 0,
  "links": [],
  "weekStart": "",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "browser",
  "refresh": "1m",
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },

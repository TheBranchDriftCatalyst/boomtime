    {
      "type": "stat",
      "title": "Coding ingest (last hour)",
      "description": "Accepted catalyst-waka heartbeat POSTs in the last hour, regardless of the dashboard time range \u2014 a freshness check. Zero means the wakatime-cli / editor plugins have stopped reporting, which no error anywhere else will tell you.",
      "datasource": {
        "type": "loki",
        "uid": "loki-v2"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#d03b3b",
                "value": null
              },
              {
                "color": "#0ca30c",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki-v2"
          },
          "expr": "sum(count_over_time({namespace=\"boomtime\", app_kubernetes_io_name=~\"$proc\"} |~ \"heartbeats\" | json | msg = \"http request\" | method = \"POST\" | path =~ `/api/v1/users/current/heartbeats(\\.bulk)?` | status < 400 [1h]))",
          "queryType": "instant",
          "instant": true,
          "range": false
        }
      ],

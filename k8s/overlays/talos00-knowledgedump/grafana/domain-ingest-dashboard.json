    {
      "type": "timeseries",
      "title": "Ingest latency",
      "description": "Server-side handling time for ingest writes, from the http-request log's dur_ms field. Bulk heartbeat POSTs are the expensive ones \u2014 a p95 in the seconds means editors are blocking on boomtime, which is a domain problem (dropped heartbeats) long before it is an ops problem.",
      "datasource": {
        "type": "loki",
        "uid": "loki-v2"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "mappings": [],
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 12,
            "gradientMode": "none",
            "spanNulls": false,
            "showPoints": "auto",
            "pointSize": 8,
            "barAlignment": 0,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisPlacement": "auto",
            "axisLabel": "handling time",
            "axisSoftMin": 0,
            "scaleDistribution": {
              "type": "linear"
            },
            "hideFrom": {
              "tooltip": false,
              "viz": false,
              "legend": false
            }
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "p95"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#d95926"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "p50"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#3987e5"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki-v2"
          },
          "expr": "max(quantile_over_time(0.95, {namespace=\"boomtime\", app_kubernetes_io_name=~\"$proc\"} |~ \"heartbeats|workouts|health_samples\" | json | msg = \"http request\" | method = \"POST\" | path =~ `/api/v1/users/current/(heartbeats|workouts|health_samples)(\\.bulk)?` | unwrap dur_ms [$bucket]))",
          "legendFormat": "p95"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "loki",
            "uid": "loki-v2"
          },
          "expr": "max(quantile_over_time(0.50, {namespace=\"boomtime\", app_kubernetes_io_name=~\"$proc\"} |~ \"heartbeats|workouts|health_samples\" | json | msg = \"http request\" | method = \"POST\" | path =~ `/api/v1/users/current/(heartbeats|workouts|health_samples)(\\.bulk)?` | unwrap dur_ms [$bucket]))",
          "legendFormat": "p50"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 15
      },
      "id": 9
    },

{
  "uid": "boomtime-keda-scaling",
  "title": "boomtime — KEDA Autoscaling",
  "tags": ["app-ops", "boomtime", "keda", "autoscaling"],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "time": { "from": "now-3h", "to": "now" },
  "refresh": "30s",
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "panels": [
    {
      "type": "row",
      "title": "boomtime-worker — scale-from-zero",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "stat",
      "title": "Scaler active (queue has work)",
      "description": "keda_scaler_active = 1 when the trigger has messages → KEDA scales the worker up from 0.",
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 1 },
      "datasource": null,
      "targets": [
        { "expr": "max(keda_scaler_active{scaledObject=\"boomtime-worker\"})", "legendFormat": "active" }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none" },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "idle", "color": "blue" }, "1": { "text": "ACTIVE", "color": "green" } } }
          ],
          "color": { "mode": "thresholds" },
          "thresholds": { "steps": [{ "color": "blue", "value": null }, { "color": "green", "value": 1 }] }
        }
      }
    },
    {
      "type": "stat",
      "title": "Current worker replicas",
      "description": "The live effect of KEDA — 0 when idle, up to maxReplicaCount (4) under load.",
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 1 },
      "datasource": null,
      "targets": [
        { "expr": "max(kube_deployment_status_replicas{namespace=\"boomtime\", deployment=\"boomtime-worker\"})", "legendFormat": "replicas" }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" },
      "fieldConfig": { "defaults": { "color": { "mode": "continuous-GrYlRd" }, "min": 0, "max": 4 } }
    },
    {
      "type": "stat",
      "title": "ScaledObject paused",
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 1 },
      "datasource": null,
      "targets": [
        { "expr": "max(keda_scaled_object_paused{scaledObject=\"boomtime-worker\"})", "legendFormat": "paused" }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none" },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "no", "color": "green" }, "1": { "text": "PAUSED", "color": "orange" } } }
          ]
        }
      }
    },
    {
      "type": "stat",
      "title": "Scaler errors (5m rate)",
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 1 },
      "datasource": null,
      "targets": [
        { "expr": "sum(rate(keda_scaled_object_errors_total{scaledObject=\"boomtime-worker\"}[5m]))", "legendFormat": "errors/s" }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 0.001 }] } } }
    },
    {
      "type": "timeseries",
      "title": "Trigger metric value (queue depth KEDA reads) vs threshold",
      "description": "keda_scaler_metrics_value is the RabbitMQ queue length the scaler polls; the ScaledObject scales on it (target 5).",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "datasource": null,
      "targets": [
        { "expr": "max(keda_scaler_metrics_value{scaledObject=\"boomtime-worker\"})", "legendFormat": "queue depth (scaler)" },
        { "expr": "vector(5)", "legendFormat": "threshold" }
      ],
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 12, "lineWidth": 2 }, "min": 0 } }
    },
    {
      "type": "timeseries",
      "title": "Worker replicas over time (scale 0 ↔ N)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "datasource": null,
      "targets": [
        { "expr": "max(kube_deployment_status_replicas{namespace=\"boomtime\", deployment=\"boomtime-worker\"})", "legendFormat": "current" },
        { "expr": "max(kube_deployment_spec_replicas{namespace=\"boomtime\", deployment=\"boomtime-worker\"})", "legendFormat": "desired (KEDA)" }
      ],
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "lineInterpolation": "stepAfter", "fillOpacity": 18, "lineWidth": 2 }, "min": 0 } }
    },
    {
      "type": "timeseries",
      "title": "All ScaledObjects — active state (cluster)",
      "description": "Every KEDA ScaledObject's active flag across the cluster — quick health glance.",
      "gridPos": { "h": 7, "w": 24, "x": 0, "y": 14 },
      "datasource": null,
      "targets": [
        { "expr": "max by (scaledObject, namespace) (keda_scaler_active)", "legendFormat": "{{namespace}}/{{scaledObject}}" }
      ],
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "lineInterpolation": "stepAfter", "fillOpacity": 10 }, "min": 0, "max": 1 } }
    }
  ]
}
